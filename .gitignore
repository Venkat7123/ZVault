# ---- Secrets: never commit ----
*.pem
*.key
.env
.env.*
.botsbank_env
.botsbank_alerts_env

# ---- Python ----
__pycache__/
*.py[cod]
.venv/
venv/
.pytest_cache/

# ---- Frontend ----
frontend/node_modules/
frontend/*.tsbuildinfo
# Build output: rebuild with `cd frontend && npm install && npm run build` (writes botsbank/dist)
botsbank/dist/

# ---- Editors / OS ----
.vscode/
.idea/
.DS_Store
Thumbs.db
*.log

# ---- Vault: demo runs create key stores and databases; never commit them ----
vault/demo_data/
*.egg-info/
